# URL base de hotel-ms-catalogo (lectura publica: hoteles, habitaciones, precios y disponibilidad).
# Desarrollo: /api/catalogo (proxy de Vite). Produccion: la URL del API Gateway, p. ej. https://<id>.execute-api.us-east-1.amazonaws.com/catalogo
# Si se deja vacio, el frontend usa el dataset local de src/data/hotels.ts (modo demo).
VITE_CATALOGO_URL=/api/catalogo

# Destino del proxy /api/catalogo durante `npm run dev`: hotel-ms-catalogo local o la EC2 (http://<ip>:8088).
VITE_CATALOGO_PROXY=http://localhost:8088

# URL base de hotel-ms-reservas: reservar como invitado (/user/reservas), consultar por codigo
# y, con cuenta de Cognito, "Mis reservas" (/cliente/reservas).
# Al crear una reserva publica el evento en Kafka y el comando en RabbitMQ (comprobante PDF por correo).
# Desarrollo: /api/reservas (proxy de Vite). Produccion: la URL del API Gateway, p. ej. https://<id>.execute-api.us-east-1.amazonaws.com/reservas
# Si se deja vacio, la reserva queda en modo demo.
VITE_RESERVAS_URL=/api/reservas

# Destino del proxy /api/reservas durante `npm run dev`: hotel-ms-reservas local o la EC2 (http://<ip>:8081).
VITE_RESERVAS_PROXY=http://localhost:8081

# AWS Cognito (cuentas de huésped): región y app client público (sin secreto) del User Pool.
# Si VITE_COGNITO_CLIENT_ID queda vacío, el sitio funciona solo en modo invitado (sin "Ingresar").
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_CLIENT_ID=
